# lane.env — the ONE file that is not in git, for one lane.
#
#   cp lane.env.example lane.env     # then fill it in
#   chmod 600 lane.env
#
# Everything else a lane needs is in this repository. This file is the whole
# remainder: credentials, and the account-side IDs that identify THIS lane.
# Carry it (password manager, encrypted volume — not email, not Slack) and a
# bare host plus this repo becomes a ringing phone number.
#
# It is matched by .gitignore's `.env.*` rule and cannot be committed by
# accident. Nothing in this repo ever prints its values; the provisioning
# scripts print names and IDs only.
#
# ── Identity of the lane ─────────────────────────────────────────────────────
LANE=dev                            # dev | test | prod
AGENT_NAME=phone-pal-dev            # MUST equal the dispatch rule's agent name
# Placeholders below are documentation values (RFC 5737 / X-digits), not a
# lane: this file is a template and a real number or address in it is one
# copy-paste from pointing a fresh lane at someone else's box.
NUMBER=+1XXXXXXXXXX                 # the number callers dial (E.164)
BOX_IP=203.0.113.10                 # RESERVED. Twilio routes here BY IP
BOX_HOST=root@203.0.113.10          # ssh target
# PUBLIC_HOSTNAME — for the Caddyfile / TLS
PUBLIC_HOSTNAME=

# ── Google ───────────────────────────────────────────────────────────────────
# One key, three jobs: the live speech model, the greeting TTS, grounded search.
GOOGLE_API_KEY=

# ── Supabase (all memory) ────────────────────────────────────────────────────
# A lane is a SEPARATE Supabase project. Never point two lanes at one project.
# SUPABASE_URL — https://<ref>.supabase.co
SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY — bypasses RLS; reads every transcript
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PROJECT_REF=
# SUPABASE_ACCESS_TOKEN — Management API token — scripts/migrate.py applies sql/
#   through it; there is no direct postgres:// path
SUPABASE_ACCESS_TOKEN=

# ── Caller identity — the pepper (as permanent as the Supabase project) ──────
# Every memory row is filed under phone_hash = HMAC-SHA256(pepper, number). The
# pepper is a ONE-WAY DOOR: set it once, before the lane's first real call, and
# never rotate it — a changed pepper orphans every caller the lane has ever
# met (their hash no longer matches any row) and the only way back is a re-hash
# plan that rewrites every row under the new key. `openssl rand -hex 32`. It is
# tied to the Supabase project above: a new project may take a new pepper, an
# existing one may not. render-config.sh refuses to render while this is empty
# and RT_REQUIRE_PEPPER is on. Never put a comment after the `=` on an empty
# line: dotenv would read it as the pepper itself.
RT_PHONE_HASH_PEPPER=
RT_REQUIRE_PEPPER=1                 # a lane never runs unpeppered; missing = refused start

# ── LiveKit (generate a pair FOR THIS BOX ONLY) ──────────────────────────────
#   docker run --rm livekit/livekit-server:v1.13.6 generate-keys
# Never share a pair between lanes: one shared namespace is how a production
# dispatch rule was silently overwritten.
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_URL=ws://127.0.0.1:7880

# ── Twilio (the carrier half — voice AND texts, one account) ─────────────────
# TWILIO_ACCOUNT_SID / TWILIO_AUTH_TOKEN — for twilio-setup.sh, and forwarded
#   into worker.env: the token signs every inbound webhook and every send.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# TWILIO_TRUNK_NAME — what the trunk is called in the console; defaults to
#   phone-pal-<LANE>, which reads badly when LANE is already a product name.
TWILIO_TRUNK_NAME=
# TWILIO_TRUNK_DOMAIN — the label before .pstn.twilio.com; unique across all
#   of Twilio, so choose it (e.g. phone-pal-dev-<something>). Outbound dials it.
TWILIO_TRUNK_DOMAIN=
TWILIO_OUTBOUND_USER=phonepaldevout # termination credential username
# TWILIO_OUTBOUND_PASSWORD — never leaves this file; 12+ chars, upper, lower, digit
TWILIO_OUTBOUND_PASSWORD=
# TWILIO_DAILY_SPEND_USD — Twilio cannot refuse a call at a cap the way Telnyx
#   did; the worker reads today's spend before every unattended dial and stops
#   at this number (rt_carrier.py). twilio-setup.sh also sets an alarm at it.
TWILIO_DAILY_SPEND_USD=25

# ── Linode (the firewall is the whole firewall — there is no ufw) ────────────
# FIREWALL_NAME — what the cloud firewall is called; defaults to
#   phone-pal-<LANE>, which reads badly when LANE is already a product
#   name, exactly as TWILIO_TRUNK_NAME above. Set it to the label the
#   firewall ALREADY has, or firewall-setup.sh will not find it and will
#   build a second one beside it.
FIREWALL_NAME=
# LINODE_TOKEN — for firewall-setup.sh
LINODE_TOKEN=
LINODE_INSTANCE_ID=
# SSH_ALLOW_CIDRS — comma-separated, e.g. 203.0.113.4/32
SSH_ALLOW_CIDRS=

# ── Optional ─────────────────────────────────────────────────────────────────
# RESEND_API_KEY — absent = email tools are never offered
RESEND_API_KEY=
RT_ALERT_EMAIL_TO=

# ── Outbound calling: TWO switches, deliberately ─────────────────────────────
# The worker will not dial unless BOTH are set. Leave the scheduler off until
# you mean it: on, it places REAL calls with no human review.
# SIP_OUTBOUND_TRUNK_ID — filled in by outbound-trunk.sh
SIP_OUTBOUND_TRUNK_ID=
RT_SCHEDULER_ENABLED=
