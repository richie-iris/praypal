# lane.env.example — PrayPal Lane Configuration
# Copy to deploy/provisioning/pray-pal/lane.env and fill in credentials.

# ── Identity & Telephony ───────────────────────────────────────────────────
LANE=pray-pal
AGENT_NAME=pray-pal
RT_PRAY_LANE=1
BOX_HOST=root@<PRAYPAL_HOST_IP>
NUMBER=+19736069515                      # Or new dedicated E.164 PrayPal number
DOMAIN=praypal.live                       # Or praypal.yourdomain.com

# ── Telephony Carrier (Twilio Shared) ──────────────────────────────────────
TWILIO_ACCOUNT_SID=ACXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
TWILIO_AUTH_TOKEN=XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
TWILIO_DAILY_SPEND_USD=25.00             # Spend ceiling circuit breaker

# ── Gemini Live & AI Models ────────────────────────────────────────────────
GOOGLE_API_KEY=AIzaSyXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
HEYGEN_API_KEY=sk_V2_hgu_k35sXMwUdF4_V3O37264ggrxvK0KToGPzUdFyYu9tWiV

# ── Isolated Database (Supabase) ───────────────────────────────────────────
SUPABASE_URL=https://<your-praypal-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_PROJECT_REF=<your-praypal-ref>
RT_ALLOWED_SUPABASE_REF=<your-praypal-ref>

# ── Cryptographic Pepper (Minimum 16 characters) ───────────────────────────
RT_REQUIRE_PEPPER=1
RT_PHONE_HASH_PEPPER=change_this_to_a_cryptographically_strong_pepper_for_praypal

# ── Stripe Subscription Keys ───────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_DEVOTION=price_...
STRIPE_PRICE_SANCTUARY=price_...

# ── Guardrails & Ceilings ─────────────────────────────────────────────────
DEFAULT_TZ=America/New_York
RT_CALL_HARD_CAP_MINS=20
RT_DAILY_MINUTES_PER_CALLER=60
RT_SCHEDULER_ENABLED=1
