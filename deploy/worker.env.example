# The runtime environment for the worker and scheduler containers.
# Copy to worker.env (gitignored) and fill in. Most names below were captured
# from the dev box on 2026-08-30 (deploy/provisioning/dev-inventory.md is that
# capture); RT_PHONE_HASH_PEPPER and RT_REQUIRE_PEPPER were added afterwards by
# the hardening pass and a lane captured earlier will not list them until it is
# re-captured. stand-up-lane.sh renders this file from lane.env, so every
# value a lane needs must be reachable from there.
#
# REQUIRED means the worker cannot serve a call without it.
#
# Layout rule: a comment never sits on the same line as an EMPTY value.
# `KEY=   # note` is read by dotenv-family parsers as KEY="# note" — non-empty,
# so it passes every "is it set" guard. For the pepper that meant callers
# hashed under a public string. Comments go on the line above.

# ─── Lane identity ────────────────────────────────────────────────────────────
ENV_MODE=dev                      # dev | test | prod — selects which .env layers
AGENT_NAME=phone-pal-dev          # must match the LiveKit dispatch rule's agent
# RT_PUBLIC_NUMBER — E.164 of the number that reaches THIS lane
RT_PUBLIC_NUMBER=
DEFAULT_TZ=America/New_York
RT_LANGUAGE=en-US                 # pin it; unset, she has been heard replying in Japanese

# ─── Google (Gemini) ──────────────────────────────────────────────────────────
# One key, three jobs: the live speech model, the TTS that renders her greeting
# clips, and grounded web search.
# GOOGLE_API_KEY — REQUIRED
GOOGLE_API_KEY=

# ─── Supabase — the entire memory layer ───────────────────────────────────────
# SUPABASE_URL — REQUIRED  https://<ref>.supabase.co
SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY — REQUIRED  bypasses RLS; reads every transcript
SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_PROJECT_REF — used by sql_push.py
SUPABASE_PROJECT_REF=
# RT_ALLOWED_SUPABASE_REF is NOT set on the dev box, which means it falls back to
# a built-in dev/test list. That is fine for dev and WRONG for prod: a worker
# whose AGENT_NAME is a production name refuses to start unless this names its
# own ref and matches SUPABASE_URL's host. Set it explicitly per lane.
RT_ALLOWED_SUPABASE_REF=

# ─── Caller identity — the pepper ─────────────────────────────────────────────
# Every memory row is filed under phone_hash = HMAC-SHA256(pepper, number). The
# pepper is a ONE-WAY DOOR: set it once, before this lane takes its first real
# call, and never rotate it — a changed pepper orphans every existing caller
# (their hash no longer matches any row) and the only way back is a re-hash
# plan that rewrites every row under the new key. `openssl rand -hex 32`, then
# keep it with the other lane secrets. Worker and scheduler share this file, so
# they cannot disagree.
# RT_PHONE_HASH_PEPPER — REQUIRED
RT_PHONE_HASH_PEPPER=
# A lane never runs unpeppered: with this on, a missing pepper is a refused
# start, not a silent fallback to plain SHA-256 that would file callers under
# hashes the peppered worker can never find again.
RT_REQUIRE_PEPPER=1

# ─── LiveKit — media and SIP ──────────────────────────────────────────────────
# Must match the pair in livekit.yaml and sip.yaml, or the worker never registers.
LIVEKIT_URL=ws://127.0.0.1:7880   # REQUIRED
# LIVEKIT_API_KEY — REQUIRED
LIVEKIT_API_KEY=
# LIVEKIT_API_SECRET — REQUIRED
LIVEKIT_API_SECRET=
LIVEKIT_SELF_HOSTED=1             # 1 on a box running its own livekit-server

# ─── Twilio — outbound leg ────────────────────────────────────────────────────
# Inbound routing is console state (trunk + dispatch rule), not env.
# SIP_OUTBOUND_TRUNK_ID — e.g. ST_xxxxxxxxxxxx (the LiveKit trunk that dials
#   <TWILIO_TRUNK_DOMAIN>.pstn.twilio.com; outbound-trunk.sh prints it)
SIP_OUTBOUND_TRUNK_ID=

# ─── Resend — email (optional by design) ──────────────────────────────────────
# Absent, send_email and send_calendar_invite are never offered to her at all,
# rather than offered and failing. That is the honesty-of-ability contract.
RESEND_API_KEY=

# ─── Twilio — the account (voice cap, SMS/MMS) ────────────────────────────────
# Absent, send_sms is never offered, every POST to /sms/incoming is refused
# (403), and every unattended dial is refused too: the worker cannot ask what
# today has cost. The auth token signs Twilio's webhooks as well as our sends,
# so it is not a send-only credential and never appears in a log line.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# TWILIO_DAILY_SPEND_USD — the daily cap the worker enforces before any
# unattended dial (rt_carrier.py). Twilio itself cannot refuse at a cap.
TWILIO_DAILY_SPEND_USD=25
# RT_SMS_WEBHOOK_URL — the exact webhook URL in the Twilio console. Twilio signs
# each POST over it, and the worker cannot see the public URL behind Caddy.
RT_SMS_WEBHOOK_URL=

# ─── Capability gates — the two that cost real money ──────────────────────────
# RT_SCHEDULER_ENABLED=1 makes outbound reminder calls REAL: the phone rings, no
# human reviews it first. Unset is the safe default and is how a fresh lane
# should start. Turn it on deliberately, per lane.
RT_SCHEDULER_ENABLED=
# SMS is gated separately by RT_SMS_ENABLED + the Twilio pair below and stays OFF
# until toll-free/10DLC registration completes. A working credential proves the
# API answers, NOT that texts arrive.

# ─── Call limits ──────────────────────────────────────────────────────────────
RT_MAX_CALL_SECONDS=3600          # NOT YET ENFORCED (finding #5): read by nothing. SUPERSEDED
                                  # by RT_CALL_HARD_CAP_MINS (rt_cadence.py), which IS enforced.
RT_CALL_HARD_CAP_MINS=35          # the enforced ceiling: automatic disconnect at this many minutes
RT_DAILY_MINUTES_PER_CALLER=90    # per-number daily ceiling
RT_CALLBACK_HOURS=8-21            # TCPA window, callee's local time
RT_CALLBACK_HOURS_LIVE=7-23       # only when the caller asked, on a live call

# ─── Behaviour ────────────────────────────────────────────────────────────────
RT_GREET=1                        # she speaks first, from a pre-rendered clip.
                                  # generate_reply() is a no-op on the 3.1 live
                                  # models, so the clip is the ONLY way she opens.
RT_RECOVERY=1                     # drain stranded post-call jobs on boot
RT_TRACE=1                        # record each call for scripts/call_console.py
# RT_AUTO_MIGRATE — 1 executes scripts/migrate.py at worker startup before serving calls
RT_AUTO_MIGRATE=

# ─── Health — three loopback ports ────────────────────────────────────────────
# The containers run with network_mode: host, so any 0.0.0.0 bind is on the
# public internet. All three stay on loopback; Caddy fronts what must be public.
RT_HEALTH_PORT=8082               # the LiveKit agents worker's own HTTP server;
                                  # must differ per worker on one host
RT_WORKER_HTTP_HOST=127.0.0.1     # what that server binds; never 0.0.0.0 here
RT_DOCKER_HEALTH_HOST=127.0.0.1   # what rt_health.py binds; never 0.0.0.0 here
RT_DOCKER_HEALTH_PORT=8080        # rt_health.py: /health (liveness, always 200) and
                                  # /ready (503 on MISCONFIGURATION — missing config,
                                  # db credentials or key — not on Supabase or LiveKit
                                  # being unreachable, which a restart would not fix).
                                  # A required-but-missing pepper never reaches /ready:
                                  # agent.py hashes a probe number before the server
                                  # starts, so the worker dies at boot and `restart:`
                                  # loops it. The compose healthcheck probes /ready on
                                  # this same host:port, and autoheal restarts a
                                  # container that stays 503.

# ─── Debugging ────────────────────────────────────────────────────────────────
# LK_GOOGLE_DEBUG=1 makes the LiveKit Google plugin log the FULL Gemini exchange
# at DEBUG — every request sent and every response received, including the ones
# it discards. It is the only view we have of the model transport; without it a
# reply that Gemini generated and the plugin threw away is indistinguishable
# from a reply that was never generated. That exact case cost a live call.
#
# Off by default for two reasons: the volume is enormous, and it contains
# verbatim everything the caller said. Turn it on to chase a bug, then off.
# Leave this 0 rather than blank: the plugin int()s it at import, and an empty
# value is not the default, it is a crash.
LK_GOOGLE_DEBUG=0
RT_LOG_LEVEL=INFO           # DEBUG is required for LK_GOOGLE_DEBUG to surface
# RT_LOG_TRANSCRIPT — 1 echoes transcript turns to stdout — same PII caveat, same rule
RT_LOG_TRANSCRIPT=

# ─── Alerting ─────────────────────────────────────────────────────────────────
# RT_ALERT_EMAIL_TO — nothing currently schedules watchdog.py
RT_ALERT_EMAIL_TO=
