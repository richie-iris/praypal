# Phone-Pal Realtime Worker configuration.
# Copy to .env.local and fill in the keys. Every variable here is read by code
# or by the LiveKit SDK; don't add ones nothing reads.
#
# This is a TEMPLATE. No real phone number, project ref, or key belongs in it:
# it is committed, and a copy-paste from here has already pointed a fresh
# checkout at the dev database and the dev number.
#
# Layout rule: a comment never sits on the same line as an EMPTY value —
# python-dotenv reads `KEY=   # note` as KEY="# note", which is non-empty and
# passes every guard. Comments go on the line above.

# --- LiveKit (read by the SDK, not by our code) ----------------------------------
# The SIP trunks and dispatch rules live on LiveKit Cloud.
LIVEKIT_URL=ws://localhost:7880
# LIVEKIT_API_KEY — REQUIRED
LIVEKIT_API_KEY=
# LIVEKIT_API_SECRET — REQUIRED
LIVEKIT_API_SECRET=

# --- Google -----------------------------------------------------------------------
# One key carries the live model, TTS and grounded search, so a leak is the
# whole bill. In Google Cloud restrict it BY API — Generative Language API plus
# Places API (New), because rt_directory.places falls back to this key when
# GOOGLE_PLACES_API_KEY is unset — and BY IP (the lane box's egress address)
# so a copied key is useless anywhere else.
# GOOGLE_API_KEY — REQUIRED: Gemini Developer API key (live model, TTS, search)
GOOGLE_API_KEY=
# GOOGLE_PLACES_API_KEY — optional: directory lookups; falls back to GOOGLE_API_KEY
GOOGLE_PLACES_API_KEY=

# --- Identity ---------------------------------------------------------------------
# The agent name registered on LiveKit (e.g. phone-pal-dev vs phone-pal-test)
AGENT_NAME=phone-pal-dev    # default: phone-pal-dev

# --- Model & voice ----------------------------------------------------------------
GEMINI_LIVE_MODEL=gemini-3.1-flash-live-preview
GEMINI_LIVE_VOICE=Aoede     # default: Aoede
# GEMINI_LIVE_TEMPERATURE — default: "" (model default)
GEMINI_LIVE_TEMPERATURE=
GEMINI_LIVE_RATE=24000      # default: 24000 Hz (config.py and agent.py both assume this)
# RT_THINKING_BUDGET — default: "" (unset); int token limit if the model needs one
RT_THINKING_BUDGET=

# --- Context window ---------------------------------------------------------------
# Compression caps TOTAL context, and the system prompt is the floor it cannot go
# below. The prompt is currently ~1,930 tokens of laws and tool declarations, plus
# ~325 of caller facts — so the conversation she can still remember is roughly
# TARGET minus 2,255. Set TARGET too close to that floor and every compression
# evicts the whole conversation: she re-asks a name mid-story. Raise the prompt
# size and you must raise TARGET with it, or memory silently disappears.
RT_CTX_TRIGGER_TOKENS=6000  # default: 6000
RT_CTX_TARGET_TOKENS=4000   # default: 4000 — leaves ~1,740 tokens of conversation

# --- The call ---------------------------------------------------------------------
DEFAULT_TZ=America/New_York # default: America/New_York
RT_LANGUAGE=en-US           # default: en-US — pin it; unset on a lane, she has been heard
                            # replying in Japanese
# RT_SYSTEM_PROMPT — default: built-in prompt, used only if hydration fails
RT_SYSTEM_PROMPT=
RT_GREET=1                  # default: 1 — she speaks first
RT_CHIME=1                  # default: 1 — the signature earcon on connection
RT_GREET_SEED=0             # default: 0 — OFF. For a caller she already knows, greet by
                            # pushing a silent "Hi." into her INPUT so she answers in
                            # her own live voice. That greeting is INTERRUPTIBLE; a
                            # rendered clip is not. First contact and outbound calls
                            # still use the clip, because the disclosure and the
                            # reason-for-calling are commitments, not improvisation.
                            # Set to 0 after it worked once and failed four times:
                            # on a failure Gemini answers the seed with nothing,
                            # and the caller sits through the whole timeout before
                            # hearing the clip they could have had at once.
RT_GREET_SEED_TEXT=Hi.      # default: "Hi." — what she is made to answer. Short:
                            # a long seed spends real time before she can think.
RT_GREET_SEED_DELAY=0.6     # default: 0.6 — settle time before the seed is pushed.
                            # Pushing at t=0 made the model answer the seed with the
                            # reply meant for the caller's first real turn.
RT_GREET_RENDER_TIMEOUT=15  # default: 15 — seconds to render that clip before giving up.
                            # A miss is not silence: it brings the check-in line forward
                            # to 8s. generate_reply() is a no-op on the 3.1 live models,
                            # so a rendered clip is the ONLY way she speaks first.
RT_HYDRATE_TIMEOUT=4        # default: 4  seconds to build the prompt before falling back
RT_LIVE_READY_TIMEOUT=8     # default: 8  seconds to wait for the Gemini Live socket
RT_MAX_CALL_SECONDS=3600    # default: 3600 — NOT YET ENFORCED (finding #5): read by nothing;
                            # SUPERSEDED by RT_CALL_HARD_CAP_MINS below, which IS enforced
# Call cadence (rt_cadence.py): minutes into the call at which she steers to a
# close, signs off, and is disconnected. The hard cap is the real ceiling.
RT_CALL_SOFT_WRAP_MINS=20   # default: 20 — steer toward a natural conclusion
RT_CALL_FIRM_WRAP_MINS=30   # default: 30 — warm, definitive sign-off
RT_CALL_HARD_CAP_MINS=35    # default: 35 — automatic disconnect
RT_DAILY_MINUTES_PER_CALLER=90  # default: 90 — per-number daily ceiling
# RT_DAILY_MINUTES_CAP — default: "" (none) — lane-wide daily minutes, reported in the
#   budget.spent event by rt_costs.py; not an enforced cutoff
RT_DAILY_MINUTES_CAP=
# RT_INBOUND_NUMBER — default: falls back to RT_PUBLIC_NUMBER — rt_costs.py uses it
#   to pick the toll-free vs local inbound rate
RT_INBOUND_NUMBER=
RT_GREET_SEED_TIMEOUT=8     # default: 8 — seconds to wait for her to actually answer the
                            # seed (RT_GREET_SEED=1) before the rendered clip plays instead
RT_MEDIA_WAIT=2.0           # default: 2.0 — seconds to wait for the SIP leg to subscribe to
                            # our track before the chime plays; earlier, it went nowhere
# RT_GREET_CACHE — default: <tmpdir>/phone-pal-greet-cache — rendered greeting
#   clips; must stay under /tmp, the only writable path in
#   the container
RT_GREET_CACHE=
RT_MAX_SEARCHES_PER_CALL=6  # default: 6 — was 0, which meant UNCAPPED, not off.
                            # 0 still disables the cap; set it deliberately.

# --- Conference Shield (bringing a third party onto a call) -----------------------
# Empty disables bridging: dial attempts fail closed and she says she couldn't connect.
# SIP_OUTBOUND_TRUNK_ID — e.g. ST_Sda3cGyf5FFp
SIP_OUTBOUND_TRUNK_ID=

# --- Worker runtime ---------------------------------------------------------------
RT_HEALTH_PORT=8082         # default: 8082 — the LiveKit agents worker's own HTTP
                            # server; must differ per worker on one host
RT_WORKER_HTTP_HOST=127.0.0.1   # default: 127.0.0.1 — what that server binds. Loopback:
                            # the containers run with network_mode: host, so 0.0.0.0
                            # is the public internet
RT_DOCKER_HEALTH_HOST=127.0.0.1 # default: 127.0.0.1 — what rt_health.py binds; loopback
                            # for the same reason as above
RT_DOCKER_HEALTH_PORT=8080  # default: 8080 — rt_health.py's /health and /ready, also on
                            # loopback; the Dockerfile and compose healthchecks hit
                            # /ready on this same host:port. /ready is 503 on
                            # MISCONFIGURATION (missing config, db credentials, key),
                            # not on Supabase/LiveKit being unreachable. A required-
                            # but-missing pepper never reaches /ready: the worker dies
                            # at boot, before the server exists
NUM_IDLE_PROCESSES=1        # default: 1
DRAIN_TIMEOUT=60            # default: 60 seconds
PARTICIPANT_WAIT_TIMEOUT=12 # default: 12 seconds for the SIP leg to join
RT_SHUTDOWN_GRACE=90        # default: 90 — the post-call memory pipeline needs this
RT_INIT_TIMEOUT=60          # default: 60 — job process startup; too low and calls get no agent
# RT_AUTO_MIGRATE — 1 executes scripts/migrate.py at worker startup before serving calls
RT_AUTO_MIGRATE=

# --- Supabase ---------------------------------------------------------------------
# SUPABASE_URL — https://<ref>.supabase.co
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_PROJECT_REF — used by sql_push.py
SUPABASE_PROJECT_REF=
# SUPABASE_ACCESS_TOKEN — Management API token, for applying sql/
SUPABASE_ACCESS_TOKEN=
# Every read and write is refused unless SUPABASE_URL's ref appears here. Set it
# to the ONE project this checkout is allowed to touch — listing more than one
# turns the guard off. Empty means the code falls back to its built-in list.
# REQUIRED (no fallback) when AGENT_NAME is a production name: the worker refuses
# to start rather than answer real callers out of a development database.
# Put YOUR project's ref here; the template ships it empty on purpose.
RT_ALLOWED_SUPABASE_REF=
# Comma-separated refs that count as PRODUCTION. sql_push.py and the scripts
# refuse destructive operations against any ref listed here without an explicit
# confirmation, and a worker with a production AGENT_NAME must point at one.
RT_PROD_SUPABASE_REFS=

# --- Caller identity ----------------------------------------------------------------
# Every memory row is filed under phone_hash = HMAC-SHA256(pepper, number). The
# pepper is a ONE-WAY DOOR: set it once, before the first real call, and never
# rotate it — a changed pepper orphans every existing caller (their hash no
# longer matches any row) and the only way back is a re-hash plan that rewrites
# every row under the new key. Generate with `openssl rand -hex 32`, keep it
# with the other secrets, and never let it differ between the worker and the
# scheduler on one lane.
# RT_PHONE_HASH_PEPPER — empty = unpeppered SHA-256, dev only
RT_PHONE_HASH_PEPPER=
# RT_REQUIRE_PEPPER — 1 refuses to start without a pepper; every deploy lane sets it
RT_REQUIRE_PEPPER=

# --- Outbound calling window ------------------------------------------------------
# TCPA: 8am-9pm at the CALLED party's local time. Enforced twice — when the job is
# scheduled AND again at the moment of dialling, because a retried or late-waking
# job would otherwise ring at whatever hour the runner came back up. Out-of-window
# jobs are moved to the next opening, never dropped.
RT_CALLBACK_HOURS=8-21      # default: 8-21
RT_CALLBACK_HOURS_LIVE=7-23 # default: 7-23 — only when the caller asked, on a call

# --- Observability ----------------------------------------------------------------
# RT_ENV — default: "production" — environment label on Sentry events
#   when SENTRY_ENVIRONMENT is unset (rt_logger.py)
RT_ENV=
LOG_LEVEL=INFO              # default: INFO — rt_logger.py's threshold (DEBUG|INFO|WARN|ERROR)
RT_LOG_LEVEL=INFO           # default: INFO — rt_obs.py's threshold; the two loggers are
                            # separate, set both
# LOG_SHIPPER_URL — default: "" (off) — HTTP endpoint rt_logger.py ships JSON
#   log lines to from a background thread
LOG_SHIPPER_URL=
# LOG_SHIPPER_API_KEY — default: "" — bearer token for LOG_SHIPPER_URL
LOG_SHIPPER_API_KEY=
# SENTRY_DSN — default: "" (off) — set to enable Sentry; PII is scrubbed
#   and send_default_pii is False (rt_logger.py)
SENTRY_DSN=
# SENTRY_ENVIRONMENT — default: RT_ENV, then "production"
SENTRY_ENVIRONMENT=
SENTRY_TRACES_SAMPLE_RATE=0.1   # default: 0.1
RT_TRACE=1                  # default: 1 — record each call for scripts/call_console.py
# RT_LOG_TRANSCRIPT — 1 echoes every transcript turn to stdout. Off by default:
#   container logs are not a place for what callers said.
#   Checked as == "1" exactly
RT_LOG_TRANSCRIPT=
RT_TRANSCRIPT_RETENTION_DAYS=30 # default: 30 — the scheduler purges stored transcripts
                            # older than this
# RT_AGENT_VERSION — stamped by the deploy; shows which build took a call
RT_AGENT_VERSION=
RT_PUBLIC_NUMBER=+1XXXXXXXXXX   # E.164 of the number the watchdog checks routing for
# RT_ALERT_SMS_TO — who the watchdog texts; empty = no SMS
RT_ALERT_SMS_TO=
# RT_ALERT_SLACK_WEBHOOK — where the watchdog posts when SMS cannot go
RT_ALERT_SLACK_WEBHOOK=
RT_WATCHDOG_STATE=/tmp/iris-watchdog-state.json

# --- Scam simulator (scripts/scam_sim.py) -----------------------------------------

# --- Twilio (the only carrier: voice cap, SMS / MMS) ------------------------------
# The pair below gates send_sms together with RT_SMS_ENABLED (Capability
# attestations) and gates bridge_call and reminder calls together with the SIP
# trunk: before any unattended dial the worker asks Twilio what today has cost
# (rt_carrier.py). The auth token is also what proves a POST to /sms/incoming
# or /twilio/usage came from Twilio — with it empty, every webhook is refused.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=+1XXXXXXXXXX  # E.164 of the Twilio number texts are sent from
TWILIO_DAILY_SPEND_USD=25       # default: 25 — today's account spend at or over this refuses every
                            # unattended dial; Twilio cannot refuse at a cap on its own
# RT_SMS_WEBHOOK_URL — the exact URL in the Twilio console under the number's
#   "A MESSAGE COMES IN". Twilio signs each POST over that URL; behind Caddy the
#   worker sees 127.0.0.1:8080 and must be told the public one. Empty = rebuilt
#   from the X-Forwarded-Proto/Host headers Caddy sets.
RT_SMS_WEBHOOK_URL=
# RT_SMS_LEDGER_DIR — default: /tmp/rt_sms — the SMS/MMS ledger the webhook
#   process and the call process share: one JSON file per caller named by
#   phone_hash (never the number), mode 0600 in a 0700 directory, newest 30 texts.
RT_SMS_LEDGER_DIR=
RT_SMS_LEDGER_RETENTION_DAYS=30 # default: 30 — ledger entries older than this are dropped
                            # on write and swept hourly; forget_me removes the file outright

# --- Scheduler --------------------------------------------------------------------
# The scheduler polls rt.scheduled_jobs and executes due items.
# Run as:  python rt_scheduler.py          (polling loop, every 60s)
#          python rt_scheduler.py --once   (one pass, then exit)
RT_SCHEDULER_INTERVAL_SECONDS=60    # default: 60 — seconds between polls
# RT_SCHEDULER_HEARTBEAT_FILE — default: <tmpdir>/phone_pal_scheduler_heartbeat — touched
#   after every pass; the compose healthcheck reads it and
#   pins it to /tmp/phone_pal_scheduler_heartbeat
RT_SCHEDULER_HEARTBEAT_FILE=

# ── Email (Resend) ────────────────────────────────────────────────────────────
# RESEND_API_KEY — absent -> send_email + send_calendar_invite are never offered
RESEND_API_KEY=
# RESEND_FROM_EMAIL — default: "Voice Companion <onboarding@resend.dev>"
RESEND_FROM_EMAIL=

# ── Capability attestations ───────────────────────────────────────────────────
# LOAD-BEARING and previously undocumented here. A credential proves the API
# answers; these prove the thing actually ARRIVES, and a human sets them after
# checking. Absent or "0" means the tool is never registered on the model at
# all, so she cannot claim the ability. See rt_capabilities.py.
# RT_SMS_ENABLED — 1 only after toll-free/10DLC verification completes
RT_SMS_ENABLED=
# RT_SCHEDULER_ENABLED — 1 only after a real outbound call has been proven
RT_SCHEDULER_ENABLED=

# ── Prompt budgets (every char is re-billed on every turn of every call) ──────
RT_PROMPT_BUDGET=5400       # whole assembled prompt; scaffolding sheds before memory
RT_KNOWLEDGE_BUDGET=1100    # the WHAT YOU KNOW block
RT_KNOWLEDGE_FLOOR=700      # memory is never trimmed below this, even over budget
RT_CONTINUITY_BUDGET=600    # narrative note + dated call history, capped together
RT_HISTORY_BUDGET=400       # default: 400 — the dated call-history lines inside continuity
RT_OURS_BUDGET=700          # default: 700 — the "ours" block: what she and the caller built
RT_SELF_BUDGET=1200         # default: 1200 — her own self-description (rt_self.py)
RT_CTX_MIN_HISTORY=1700     # conversation she must still hold after a compression
RT_FACTS_BUDGET_SEC=6       # wall-clock the post-call fact dual-write may spend

# ── Post-call durability ──────────────────────────────────────────────────────
RT_RECOVERY=1               # 0 disables the boot sweep that rescues crashed calls
RT_RECOVERY_BOOT_LIMIT=5    # how many queued post-calls one boot may drain
RT_RECOVERY_MAX_ATTEMPTS=3
RT_RECOVERY_MIN_AGE_SEC=900 # never claim a job younger than this — the call may be live

# ── Watchdog (scripts/watchdog.py, cron) ──────────────────────────────────────
RT_WATCHDOG_ANSWER_TIMEOUT=20   # seconds to wait for a worker to join the probe room

# ── Test-only ─────────────────────────────────────────────────────────────────
# RT_HARNESS_TEST_MODE=1 belongs in harness/.env.harness and NOWHERE else. It
# stops the post-call planner sending real email/SMS or booking real outbound
# calls. Set in a real environment it silently disables the agent's whole
# autonomous side. Checked as == "1" exactly: "true"/"yes"/"on" all read as off.

# ── Trial lane (rt_trial.py) ──────────────────────────────────────────────────
# RT_TRIAL_LANE — 1 forces trial governance and prompt pin on any lane name
RT_TRIAL_LANE=
# RT_TRIAL_STUDY — e.g. NCT01960348; study protocol this lane serves (empty = all)
RT_TRIAL_STUDY=

# ── PrayPal lane (rt_pray.py) ─────────────────────────────────────────────────
# RT_PRAY_LANE — 1 forces spiritual pantheon, sacred prompt, and crisis shield on any lane name
RT_PRAY_LANE=

