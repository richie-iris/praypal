# .env.test.example — the test lane's environment.
#
# NOTE: the file this replaces was called ".example" but held a complete set of
# LIVE credentials — LiveKit key+secret, a Google API key, a Resend key, and a
# Supabase SERVICE-ROLE JWT for the dev project. It was tracked, not just in
# history. Every value below is a placeholder; nothing real belongs in a file
# that git tracks.

ENV_NAME=test
AGENT_NAME=phone-pal-test
RT_HEALTH_PORT=8086               # must differ from the dev worker on one host

# LiveKit — generate a pair per box, never shared between lanes.
# Sharing one LiveKit namespace across lanes is what let the test lane's
# dispatch rule silently overwrite the prod lane's.
LIVEKIT_URL=wss://<this-lane-host>
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Gemini: live model, greeting TTS, grounded search.
GOOGLE_API_KEY=
GEMINI_LIVE_MODEL=gemini-3.1-flash-live-preview

# Supabase — the test lane MUST point at its own project, not dev's.
SUPABASE_URL=https://<test-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PROJECT_REF=
# RT_ALLOWED_SUPABASE_REF — pin to the test ref so a stray URL is refused
RT_ALLOWED_SUPABASE_REF=

# Caller identity — the pepper. Every memory row is filed under
# phone_hash = HMAC-SHA256(pepper, number). It is a ONE-WAY DOOR: set it once,
# before this lane's first real call, and never rotate it — a changed pepper
# orphans every existing caller and the only way back is a re-hash plan that
# rewrites every row under the new key. `openssl rand -hex 32`; tied to the
# test project above. Comment stays on this line, never after the `=`: dotenv
# would read `RT_PHONE_HASH_PEPPER=  # note` as a real, public pepper.
RT_PHONE_HASH_PEPPER=
# A lane never runs unpeppered: a missing pepper is a refused start.
RT_REQUIRE_PEPPER=1

# RT_PUBLIC_NUMBER — the number that reaches the test lane
RT_PUBLIC_NUMBER=

# Email (optional — absent, the email tools are never offered).
RESEND_API_KEY=
RESEND_FROM_EMAIL=
