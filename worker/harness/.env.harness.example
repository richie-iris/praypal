# Copy to .env.harness (gitignored). Loaded with override=True BEFORE .env.local,
# so the harness wins inside the suite regardless of what the lane is set to.
#
# Point this at a DEVELOPMENT project. The suite wipes its two test callers on
# every run and refuses to start against anything it does not recognise as dev.
SUPABASE_URL=https://<dev-ref>.supabase.co
SUPABASE_PROJECT_REF=<dev-ref>

# REQUIRED. The post-call planner runs for real during the suite — live model,
# real database. This computes the plan (so tests can assert on its shape) but
# never executes it: no real email, no real SMS, no row in rt.scheduled_jobs.
#
# It exists because a full suite run once wrote twelve real scheduled jobs into
# the live table, including an outbound call queued days into the future, which
# had to be purged by hand. RESEND_API_KEY is present in every lane's env, so
# without this a replay of a real transcript emails a real person.
RT_HARNESS_TEST_MODE=1
